{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "python hooks/tripwire_stop.py" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|Bash",
        "hooks": [
          { "type": "command", "command": "python hooks/tripwire_pretooluse.py" }
        ]
      }
    ]
  }
}
